[% WRAPPER "wrapper-staff-tool-plugin.inc" method="config" plugin_title="INNReach" %]
[% USE raw %]
[% USE Asset %]
  <style>
    .CodeMirror {
      border: 2px solid #eee;
      height: auto;
    }
  </style>

[% Asset.js( "lib/codemirror/codemirror.min.js" ) | $raw %]
[% Asset.css("lib/codemirror/codemirror.min.css") | $raw %]
[% Asset.css("lib/codemirror/lint.min.css") | $raw %]

</head>
<body>

<div id="doc3" class="panel panel-default" style="padding:10px;">
     <h1 class="panel-title">INN-Reach: Configuration</h1>



    [% IF errors %]
        [% FOREACH error IN errors %]
            <div class="dialog error">
                [% SWITCH error.code %]
                [% CASE 'ILLModule_disabled' %]<span>The <strong>mandatory</strong> system preference <a href="/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=ILLModule">ILLModule<a> is disabled.</span>
                [% CASE 'CirculateILL_enabled' %]<span>The system preference <strong>CirculateILL</strong> is enabled, but it is incompatible with this plugin.</span>
                [% CASE 'undefined_partners_library_id' %]<span>[<strong>[% error.central_server | html %]</strong>] The configured <strong>partners_library_id</strong> '[% error.value | html %]' is not defined on the system. Please define it <a href="/cgi-bin/koha/admin/branches.pl?op=add_form">here</a></span>
                [% CASE 'undefined_partners_category' %]<span>[<strong>[% error.central_server | html %]</strong>] The configured <strong>partners_category</strong> '[% error.value | html %]' is not defined on the system.</span>
                [% CASE 'library_missing_description' %]<span>[<strong>[% error.central_server | html %]</strong>] The configured <strong>library_to_location</strong> mapping for '[% error.library | html %]' is missing the <strong>description</strong>.</span>
                [% CASE 'library_missing_location' %]<span>[<strong>[% error.central_server | html %]</strong>] The configured <strong>library_to_location</strong> mapping for '[% error.library | html %]' is missing the <strong>location</strong> code.</span>
                [% CASE 'anonymous_patron_not_set' %]<span>Some patrons have their privacy set to <strong>never</strong>, but the <a href="/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=AnonymousPatron">AnonymousPatron</a> system preference is not set. Koha cannot anonymize their checkouts and holds, and aborts the checkin or hold transition instead, which also discards any work this plugin did in the same transaction.</span>
                [% CASE 'anonymous_patron_not_found' %]<span>The <a href="/cgi-bin/koha/admin/preferences.pl?op=search&searchfield=AnonymousPatron">AnonymousPatron</a> system preference points at patron '[% error.value | html %]', which does not exist. Anonymizing checkouts and holds will fail, aborting the checkin or hold transition, which also discards any work this plugin did in the same transaction.</span>
                [% CASE 'partners_category_privacy_never' %]<span>[<strong>[% error.central_server | html %]</strong>] The configured <strong>partners_category</strong> '[% error.value | html %]' has its default privacy set to <strong>never</strong>. Every virtual ILL patron created for this central server will have its checkouts and holds anonymized, which is rarely what you want for partner libraries. Change it <a href="/cgi-bin/koha/admin/categories.pl">here</a>.</span>
                [% END %]
            </div>
        [% END %]
    [% END %]

    <br/>
          <div class="panel-heading">
                  <h3 class="panel-title">Central servers</h3>
      </div>
      <div class="panel-body">
        <form method="post">
          <input type="hidden" name="class"  value="[% CLASS %]"/>
          <input type="hidden" name="method" value="configure"/>
          <input type="hidden" name="step"   value="configure"/>
          <input type="hidden" name="save"   value="1"/>
          <input type="hidden" name="op"     value="cud-save"/>
          [% INCLUDE 'csrf-token.inc' %]
          <div class="input-group">
            <span class="input-group-addon" id="configuration_label">Configuration</span>
            <textarea rows="200"
                      columns="200"
                      class="form-control"
                      aria-describedby="configuration_label"
                      name="configuration"
                      id="configuration">[%- configuration -%]</textarea>
          </div>
          <br/>
          <button type="submit" value="Save" class="btn btn-default" type="button">Save</button>
        </form>
  </div>



    [% Asset.js( "lib/codemirror/yaml.min.js" ) | $raw %]
    [% Asset.js( "lib/codemirror/lint.min.js" ) | $raw %]
    [% Asset.js( "lib/linters/js-yaml.min.js" ) | $raw %]
    [% Asset.js( "lib/codemirror/yaml-lint.min.js" ) | $raw %]

    <script>
        $( document ).ready( function () {
            var editor = CodeMirror.fromTextArea( document.getElementById( "configuration" ), {
                lineNumbers: true,
                mode: 'text/x-yaml',
                lineWrapping: false,
                gutters: ["CodeMirror-lint-markers"],
                lint: true
            });
        });
    </script>
    [% INCLUDE 'intranet-bottom.inc' %]
  [% END %]
  